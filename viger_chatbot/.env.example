# rules = chatbot theo từ khóa, miễn phí (mặc định); claude = dùng Claude (cần ANTHROPIC_API_KEY, tính phí)
CHATBOT_ENGINE=rules
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-opus-5-5
# File câu hỏi thường gặp (mặc định data/faq.json)
CHATBOT_FAQ_FILE=

# Web được phép gọi /chat từ trình duyệt, cách nhau dấu phẩy
CHATBOT_ALLOWED_ORIGINS=https://viger.edu.vn,https://holland.viger.edu.vn
CHATBOT_RATE_PER_MIN=20
# File dữ liệu (mặc định data/DU_LIEU_16_BANG_390_TRUONG_DA_CHUAN_HOA.xlsx)
CHATBOT_DATA_FILE=

# Holland (token scope results:read)
HOLLAND_API_URL=https://holland.viger.edu.vn/api/v1
HOLLAND_API_TOKEN=

# CRM (token kênh chatbot, scope chat:write). Để trống = không gửi phiên chat
CRM_API_URL=https://crm.viger.edu.vn/api/v1
CRM_API_TOKEN=
