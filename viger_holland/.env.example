APP_NAME="Holland Test"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


APP_TIMEZONE=Asia/Ho_Chi_Minh
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=holland
DB_USERNAME=root
DB_PASSWORD=

# ---------------- Web Holland ----------------
# Thuật toán chấm điểm đang dùng (xem docs/THAY_THUAT_TOAN.md)
# Kết nối CRM (tắt = chạy chế độ dự phòng, khách nằm chờ trong hàng đợi)
HOLLAND_CRM_ENABLED=false
HOLLAND_CRM_URL=
HOLLAND_CRM_TOKEN=
# Xóa SĐT/email trong lượt làm bài sau khi CRM xác nhận (chỉ bật khi CRM đã sao lưu đều đặn)
HOLLAND_PURGE_CONTACT=false
# Đường dẫn script chatbot (để trống = không chèn)
HOLLAND_CHAT_WIDGET_URL=
# Tài khoản quản trị đầu tiên (seeder chỉ tạo khi chưa có, không ghi đè)
HOLLAND_ADMIN_USERNAME=admin
HOLLAND_ADMIN_PASSWORD=
HOLLAND_ADMIN_NAME="Quản trị viên"
HOLLAND_ADMIN_EMAIL=
# Tài khoản marketing mẫu (không bắt buộc, để thử)
HOLLAND_EDITOR_USERNAME=
HOLLAND_EDITOR_PASSWORD=
HOLLAND_EDITOR_NAME="Marketing"
