APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Kết nối CRM (HOP_DONG_KET_NOI mục 4) ---
# Phía web chính: form liên hệ gửi sang CRM. Để trống => không gửi.
# Local: CRM_API_URL=http://crm.localhost:8001/api/v1 và chạy thêm "php artisan queue:work"
CRM_API_URL=
CRM_API_TOKEN=
CRM_CONSENT_VERSION=lien-he-2026-11
# Phía CRM (tạm trong viger_web): băm SHA-256 của token kênh website
#   php -r "echo hash('sha256', 'token-cua-kenh');"
CRM_CHANNEL_WEBSITE_TOKEN_HASH=
CRM_CHANNEL_WEBSITE_ENABLED=true
# Kênh chatbot (viger_chatbot): băm SHA-256 của token, token gốc đặt ở CRM_API_TOKEN bên viger_chatbot
CRM_CHANNEL_CHATBOT_TOKEN_HASH=
CRM_CHANNEL_CHATBOT_ENABLED=true

# Dịch vụ chatbot (viger_chatbot), vd https://chat.viger.edu.vn. Để trống = widget trả lời soạn sẵn
CHATBOT_API_URL=
# Kênh Holland gửi khách + kết quả Holland vào CRM (băm SHA-256 của token cấp cho app Holland)
CRM_CHANNEL_HOLLAND_TOKEN_HASH=
CRM_CHANNEL_HOLLAND_ENABLED=true
# Địa chỉ Holland cho nút "Chép link trắc nghiệm cho khách" trên hồ sơ CRM
CRM_HOLLAND_URL=http://holland.localhost:8002
